[Unit]
Description=Alarm Monitor - Serial Listener & Camera Recording
After=network.target

[Service]
Type=simple
User=www-data
Group=dialout
ExecStart=/usr/bin/python3 /var/www/html/alarm_monitor.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
