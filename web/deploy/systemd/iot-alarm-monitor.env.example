# Install this file as /etc/default/iot-alarm-monitor (root:root, mode 0640).
# Prefer a stable /dev/serial/by-id path over a changing ttyUSB number.
ALARM_SERIAL_PORTS=/dev/ttyUSB0,/dev/ttyACM0
ALARM_BAUD_RATE=9600
ALARM_SERIAL_TIMEOUT_SECONDS=0.2
ALARM_SERIAL_WRITE_TIMEOUT_SECONDS=1
ALARM_HANDSHAKE_TIMEOUT_SECONDS=8
ALARM_STATUS_INTERVAL_SECONDS=10
ALARM_STATUS_RESPONSE_TIMEOUT_SECONDS=2
ALARM_COMMAND_CONFIRM_SECONDS=2
ALARM_RECONNECT_MIN_SECONDS=2
ALARM_RECONNECT_MAX_SECONDS=30

ALARM_STREAM_PORT=8082
ALARM_MAX_RECORDING_SECONDS=3600
ALARM_MAX_RECORDING_MIB=2048
ALARM_MIN_FREE_MIB=2048
ALARM_DISK_SAFETY_MIB=128
ALARM_RECORDING_RETRY_LIMIT=3
ALARM_LOG_MAX_KIB=1024
ALARM_LOG_BACKUPS=2
ALARM_DATA_DIR=/var/www/html/data
ALARM_RECORD_DIR=/var/www/html/data/recordings
ALARM_FFMPEG_BIN=/usr/bin/ffmpeg
ALARM_IPC_SOCKET=/run/iot-alarm-monitor/control.sock
ALARM_IPC_TTL_SECONDS=10
